    "configuration": {
      "title": "Ken Markdown Editor",
      "properties": {
        "kenMarkdown.fontSize": {
          "type": "number",
          "default": 16,
          "minimum": 8,
          "maximum": 40,
          "markdownDescription": "Base font size of body text, in pixels. Headings, code and lists scale from it."
        },
        "kenMarkdown.bodyFontFamily": {
          "type": "string",
          "default": "\"Hanken Grotesk\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
          "markdownDescription": "CSS font stack for body text. `Hanken Grotesk` is bundled; any font installed on your system works too."
        },
        "kenMarkdown.headingFontFamily": {
          "type": "string",
          "default": "\"Newsreader\", Georgia, serif",
          "markdownDescription": "CSS font stack for headings. `Newsreader` is bundled."
        },
        "kenMarkdown.quoteFontFamily": {
          "type": "string",
          "default": "",
          "markdownDescription": "CSS font stack for block quotes, which are set in italics. Empty uses the heading font (`kenMarkdown.headingFontFamily`)."
        },
        "kenMarkdown.codeFontFamily": {
          "type": "string",
          "default": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Consolas, monospace",
          "markdownDescription": "CSS font stack for inline code and code blocks. `JetBrains Mono` is bundled."
        },
        "kenMarkdown.lineHeight": {
          "type": "number",
          "default": 1.85,
          "minimum": 1,
          "maximum": 3,
          "markdownDescription": "Line height of body text, as a multiple of the font size."
        },
        "kenMarkdown.maxWidth": {
          "type": "number",
          "default": 720,
          "minimum": 320,
          "maximum": 2400,
          "markdownDescription": "Maximum width of the text column, in pixels."
        },
        "kenMarkdown.toolbar": {
          "type": "string",
          "enum": [
            "bottom",
            "top",
            "hidden"
          ],
          "enumDescriptions": [
            "Toolbar at the bottom of the editor.",
            "Toolbar at the top of the editor.",
            "No toolbar (use the slash menu and keyboard shortcuts)."
          ],
          "default": "bottom",
          "markdownDescription": "Where the formatting toolbar sits."
        },
        "kenMarkdown.imageFolder": {
          "type": "string",
          "default": "_Images",
          "markdownDescription": "Folder, next to the document, that pasted and dropped images are copied into (created when first needed). Leave empty to save images beside the document. Other files are always saved beside the document."
        },
        "kenMarkdown.alwaysShowProperties": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Show the Properties (frontmatter) panel above every document, even one without frontmatter. Nothing is added to the file until you add a property."
        },
        "kenMarkdown.commentAuthor": {
          "type": "string",
          "default": "",
          "markdownDescription": "Your name on comments you add. Empty uses git's `user.name`, else your OS account name."
        },
        "kenMarkdown.collaboration.port": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 65535,
          "markdownDescription": "Port the collaboration hub listens on when you start a session. `0` picks a free port."
        },
        "kenMarkdown.collaboration.allowNetwork": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Let people on your network join sessions you start (the hub listens on all interfaces instead of only this machine). Invites still carry a secret token. Not needed for Live Share, which forwards the port for you."
        }
      }
    },
