        "key": "ctrl+alt+9",
        "mac": "cmd+alt+9",
        "when": "kenMarkdown.editorFocused && activeCustomEditorId == 'kenMarkdown.editor'"
      },
      {
        "command": "kenMarkdown.quote",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "when": "kenMarkdown.editorFocused && activeCustomEditorId == 'kenMarkdown.editor'"
      },
      {
        "command": "kenMarkdown.codeBlock",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c",
        "when": "kenMarkdown.editorFocused && activeCustomEditorId == 'kenMarkdown.editor'"
      },
      {
        "command": "kenMarkdown.addComment",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "kenMarkdown.editorFocused && activeCustomEditorId == 'kenMarkdown.editor'"
      },
      {
        "command": "kenMarkdown.undo",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "kenMarkdown.editorFocused && activeCustomEditorId == 'kenMarkdown.editor'"
      },
      {
        "command": "kenMarkdown.redo",
        "key": "ctrl+y",
        "mac": "cmd+shift+z",
        "when": "kenMarkdown.editorFocused && activeCustomEditorId == 'kenMarkdown.editor'"
      },
      {
        "command": "kenMarkdown.redo",
        "key": "ctrl+shift+z",
        "mac": "cmd+shift+z",
        "when": "kenMarkdown.editorFocused && activeCustomEditorId == 'kenMarkdown.editor'"
      },
      {
        "command": "kenMarkdown.showShortcuts",
        "key": "ctrl+/",
        "mac": "cmd+/",
        "when": "kenMarkdown.editorFocused && activeCustomEditorId == 'kenMarkdown.editor'"
      }
    ]
  },
